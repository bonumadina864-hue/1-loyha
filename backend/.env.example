# Application
NODE_ENV=development
PORT=3000
ENABLE_DEV_LOGIN=true

# Security & Crypto
# 32-byte hex key for master KEK in development
PAIRLY_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_SECRET=pairly_super_secure_jwt_access_secret_key_2026_dev
JWT_REFRESH_SECRET=pairly_super_secure_jwt_refresh_secret_key_2026_dev
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Database (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pairly
DATABASE_SSL=false

# Redis (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin & Compliance
REQUIRE_DUAL_APPROVAL=false
ADMIN_TOTP_ENCRYPTION_KEY=admin_totp_key_must_be_32_bytes_len!

# Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=pairly-vault
